# Local Compose example only. Create these files with mode 0600; never commit them.
DRILLLOOP_DB_PASSWORD_FILE=./secrets/postgres_password
DRILLLOOP_SESSION_SECRET_FILE=./secrets/session_secret
DRILLLOOP_USERS_FILE=./secrets/users.json
DRILLLOOP_ENVIRONMENT=local
DRILLLOOP_BUILD_VERSION=dev
DRILLLOOP_BUILD_REVISION=unknown
DRILLLOOP_COOKIE_SECURE=0
DRILLLOOP_TRUSTED_HOSTS=localhost,127.0.0.1
DRILLLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DRILLLOOP_UPLOAD_SCAN_MODE=disabled
DRILLLOOP_PARSER_TIMEOUT_SECONDS=15
DRILLLOOP_PARSER_QUEUE_TIMEOUT_SECONDS=30
DRILLLOOP_PARSER_MEMORY_MB=768
DRILLLOOP_SCANNER_TIMEOUT_SECONDS=5
# Optional profile: docker compose --profile scanner up --build --wait.
# Required mode uses clamd over the private Compose network and fails readiness if it is absent.
DRILLLOOP_SCANNER_HOST=clamav
DRILLLOOP_SCANNER_PORT=3310
# Proposed local policy only; this freshness threshold needs Security Operations approval.
DRILLLOOP_SCANNER_MAX_SIGNATURE_AGE_HOURS=72
# Official ClamAV image performs this many controlled database checks per day.
DRILLLOOP_FRESHCLAM_CHECKS=4
DRILLLOOP_BIND_ADDRESS=127.0.0.1
DRILLLOOP_ENABLE_DEMO_SEED=0
DRILLLOOP_DEMO_OWNER_ID=
DEMO_SEED=0
# Optional: point to a locally installed faster-whisper CTranslate2 model folder.
WHISPER_MODEL_PATH=
